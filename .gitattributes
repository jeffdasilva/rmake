# Span fixture inputs deliberately contain trailing separators and raw bytes.
tests/cases/span-*/input -text whitespace=-blank-at-eol,-blank-at-eof

# Wildcard input patterns and archives retain all filename bytes.
tests/cases/wildcard-*/pattern -text whitespace=-blank-at-eol,-blank-at-eof
tests/cases/wildcard-*/*.a -text

# Literal NUL and CRLF reader fixtures preserve their source bytes.
tests/cases/nul-reader-*/Makefile -text
tests/cases/rule-warning-*/Makefile -text

# Directive fixtures intentionally retain control bytes next to line endings.
tests/cases/directive-space-*/Makefile -text whitespace=-blank-at-eol,-blank-at-eof

# Preserve complete/partial BOMs, NULs and original line endings.
tests/cases/bom-reader-*/*.mk -text
tests/cases/bom-reader-*/Makefile -text whitespace=-blank-at-eol,-blank-at-eof

# Conditional fixtures distinguish literal control bytes from expansion output.
tests/cases/conditional-space-*/Makefile -text whitespace=-blank-at-eol,-blank-at-eof

# Definition fixtures retain control bytes and header/body stream boundaries.
tests/cases/qualified-define-*/Makefile -text whitespace=-blank-at-eol,-blank-at-eof

# Built-in command data preserves observable spaces before recipe newlines.
crates/rmake-core/data/*.mk -text whitespace=-blank-at-eol,-blank-at-eof
