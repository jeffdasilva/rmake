VPATH = src
GPATH = src
export .SHELLSTATUS
colon := :
WRITE = $(shell exit 7)
NAME = $(eval parent$(colon) export ANCHOR_3190 := named)
READING = $(info retained=[$@])
REOPEN = $(eval src/parent$(colon) SEEN := $$(READING))
DISPLAY = $(eval src/parent$(colon) DISPLAY := $$(info env=[$$(SEEN)]))
src/parent: @ := destination
parent: input
	@$(WRITE)$(NAME)touch src/parent
after:
	@$(REOPEN)$(DISPLAY):
