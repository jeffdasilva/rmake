K=old
A$+:=$(K)
B$?::=$(K)
C$!:::=$(K)
D$=+=$(K)
E$:+=$(K)
F$-?=$(K)
K=new
$(info A=<$(value A)>|$(A)|$(flavor A))
$(info B=<$(value B)>|$(B)|$(flavor B))
$(info C=<$(value C)>|$(C)|$(flavor C))
$(info D=<$(value D)>|$(D)|$(flavor D))
$(info E=<$(value E)>|$(E)|$(flavor E))
$(info F=<$(value F)>|$(F)|$(flavor F))
all:
	@true
