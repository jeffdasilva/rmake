override GNUMAKEFLAGS = -e READY:=yes STATE:=$$(if\ $$(value\ GNUMAKEFLAGS),pending,cleared) A=$$(file\ >>seen,A)$$(info\ GNU_A)$$(MISSING_Aÿ)
override MAKEFLAGS = $(if $(filter environment,$(origin READY)),$(file >>seen,FLAGS)$(info FLAGS A=[$(A)]/$(origin A)/$(flavor A) STATE=[$(STATE)] GNU=[$(if $(value GNUMAKEFLAGS),pending,cleared)] SEEN=[$(file <seen)]) B=$$(file\ >>seen,B)$$(info\ GNU_B)$$(MISSING_Bÿ) --warn-undefined-variables)
