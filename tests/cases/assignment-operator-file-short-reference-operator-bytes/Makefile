A$+=value
$(info case0=<$(value A)>|$(flavor A)|$(origin A))
B$-=value
$(info case1=<$(value B)>|$(flavor B)|$(origin B))
C$?=value
$(info case2=<$(value C)>|$(flavor C)|$(origin C))
D$:=value
$(info case3=<$(value D)>|$(flavor D)|$(origin D))
E$!=value
$(info case4=<$(value E)>|$(flavor E)|$(origin E))
F$==value
$(info case5=<$(value F)>|$(flavor F)|$(origin F))
G$::=value
$(info case6=<$(value G)>|$(flavor G)|$(origin G))
H$:::=value
$(info case7=<$(value H)>|$(flavor H)|$(origin H))
all:
	@true
