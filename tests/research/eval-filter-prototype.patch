+/// Conservative name membership only. A hit always requires exact key/layer
+/// comparison; saturation and collisions can only select the slower path.
+#[derive(Clone, Copy, Default)]
+struct ActiveNames([u64; 16]);
+impl ActiveNames {
+    fn positions(name: &[u8]) -> [(usize, u64); 2] {
+        let mut hash = 0xcbf29ce484222325u64;
+        for byte in name {
+            hash = (hash ^ u64::from(*byte)).wrapping_mul(0x100000001b3);
+        }
+        hash ^= hash >> 32;
+        [hash, hash.rotate_right(29)]
+            .map(|value| (((value >> 6) as usize) & 15, 1u64 << (value & 63)))
+    }
+    fn insert(&mut self, name: &[u8]) {
+        for (word, bit) in Self::positions(name) {
+            self.0[word] |= bit;
+        }
+    }
+    fn may_contain(&self, name: &[u8]) -> bool {
+        Self::positions(name)
+            .iter()
+            .all(|(word, bit)| self.0[*word] & bit != 0)
+    }
+}
