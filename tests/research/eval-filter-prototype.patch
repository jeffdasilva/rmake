+#[cfg(test)]
+mod active_context_tests {
+    use super::*;
+    use std::collections::HashSet;
+
+    #[test]
+    fn inherited_membership_keeps_exact_keys_shared_snapshots_and_collisions() {
+        let store = VariableStore::new();
+        let mut expansion = store.expansion(ExpansionContext::pure());
+        let name = |index: u16| [b"key-".as_slice(), &index.to_le_bytes(), &[0xff]].concat();
+        let mut expected = HashSet::new();
+        for index in 0..256 {
+            let key = (
+                name(index),
+                (index % 3 != 0).then_some(usize::from(index % 3)),
+            );
+            expected.insert(key.clone());
+            expansion.active.push(key);
+            expansion.inherited_active = expansion.snapshot_active();
+            expansion.active.clear();
+            assert!(expansion.is_active(&name(0), None));
+        }
+        let parent = expansion.inherited_active.clone();
+        expansion.active.push((b"child".to_vec(), None));
+        expansion.inherited_active = expansion.snapshot_active();
+        expansion.active.clear();
+        assert!(expansion.is_active(b"child", None));
+        expansion.inherited_active = parent;
+        assert!(!expansion.is_active(b"child", None));
+        for saturated in [false, true] {
+            // Force every lookup through the collision path on the second
+            // pass. Exact names/layers, rather than bits, must decide cycles.
+            if saturated {
+                Arc::make_mut(expansion.inherited_active.as_mut().unwrap()).names =
+                    ActiveNames([u64::MAX; 16]);
+            }
+            for index in 0..512 {
+                let name = name(index);
+                for layer in [None, Some(0), Some(1), Some(2), Some(3)] {
+                    assert_eq!(
+                        expansion.is_active(&name, layer),
+                        expected.contains(&(name.clone(), layer))
+                    );
+                }
+            }
+        }
+    }
+}
