+#[cfg(test)]
+mod active_ownership_tests {
+    use super::*;
+    use crate::parser::Database;
+    #[test]
+    fn eval_reclaims_local_keys_after_success_cycle_error_and_unsupported_access() {
+        let backing = VariableStore::new();
+        let mut database = Database::default();
+        database
+            .variables
+            .define(b"R0", b"$(R0)", Assignment::Recursive, Origin::File)
+            .unwrap();
+        let mut expansion = backing.expansion(ExpansionContext::pure());
+        expansion.store = StoreAccess::Database(&mut database);
+        let keys = vec![(b"R0".to_vec(), Some(0)), (b"binary-\xff".to_vec(), None)];
+        expansion.active = keys.clone();
+        let vector = expansion.active.as_ptr();
+        let name = expansion.active[0].0.as_ptr();
+        assert!(expansion.evaluate_buffer(b"VALUE=one\n").is_ok());
+        assert_eq!(expansion.active, keys);
+        assert_eq!(expansion.active.as_ptr(), vector);
+        assert_eq!(expansion.active[0].0.as_ptr(), name);
+        let error = expansion.evaluate_buffer(b"RESULT := $(R0)\n").unwrap_err();
+        assert!(
+            error
+                .diagnostic()
+                .as_bytes()
+                .starts_with(b"Recursive variable 'R0'")
+        );
+        assert_eq!(expansion.active, keys);
+        assert_eq!(expansion.active.as_ptr(), vector);
+        assert_eq!(expansion.active[0].0.as_ptr(), name);
+        expansion.store = StoreAccess::Read(&backing);
+        assert!(matches!(
+            expansion.evaluate_buffer(b"VALUE=two\n"),
+            Err(ExpandError::Unsupported(_))
+        ));
+        assert_eq!(expansion.active, keys);
+        assert_eq!(expansion.active.as_ptr(), vector);
+        // A retained host context must keep its immutable keys if reclaiming
+        // ownership needs to take the shared-snapshot clone path.
+        let suspended = expansion.suspend_active().unwrap();
+        let retained = suspended.clone();
+        expansion.active = Arc::unwrap_or_clone(suspended).keys;
+        assert_eq!(expansion.active, keys);
+        expansion.active[0].0.push(b'!');
+        assert_eq!(retained.keys, keys);
+    }
+}
